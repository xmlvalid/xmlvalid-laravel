{
    "name": "xmlvalid/xmlvalid-laravel",
    "description": "Laravel integration for the xmlvalid API: a validation rule for XML and e-invoices (Peppol, XRechnung, Factur-X, UBL, XSD, Schematron), webhooks as events, Artisan commands",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "xml", "validation", "xsd", "schematron", "e-invoice", "peppol", "xrechnung", "factur-x", "ubl", "en16931"],
    "homepage": "https://xmlvalid.com/docs/api",
    "support": {
        "email": "support@xmlvalid.com",
        "docs": "https://xmlvalid.com/docs/api",
        "issues": "https://github.com/xmlvalid/xmlvalid-laravel/issues",
        "source": "https://github.com/xmlvalid/xmlvalid-laravel"
    },
    "authors": [
        {
            "name": "xmlvalid",
            "email": "support@xmlvalid.com",
            "homepage": "https://xmlvalid.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "xmlvalid/xmlvalid-php": "^1.2"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Xmlvalid\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xmlvalid\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Xmlvalid\\Laravel\\XmlvalidServiceProvider"
            ],
            "aliases": {
                "Xmlvalid": "Xmlvalid\\Laravel\\Facades\\Xmlvalid"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "lint": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
